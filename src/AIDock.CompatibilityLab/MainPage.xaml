<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AIDock.CompatibilityLab.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AIDock.CompatibilityLab"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <InfoBar
            IsClosable="False"
            IsIconVisible="True"
            IsOpen="True"
            Severity="Informational"
            Title="Manual provider compatibility test"
            Message="This harness never reads the page DOM and never records credentials, cookies, tokens, prompts, responses, or full URLs." />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="ProviderBox"
                DisplayMemberPath="DisplayName"
                Header="Provider"
                MinWidth="170"
                SelectionChanged="ProviderBox_SelectionChanged" />
            <TextBox
                x:Name="ProfileRootBox"
                Grid.Column="1"
                Header="Test data root"
                IsSpellCheckEnabled="False" />
            <ComboBox
                x:Name="ProfileModeBox"
                Grid.Column="2"
                Header="Profile"
                SelectedIndex="0">
                <ComboBoxItem Content="Persistent" Tag="persistent" />
                <ComboBoxItem Content="Fresh disposable" Tag="fresh" />
            </ComboBox>
            <Button
                x:Name="StartButton"
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Click="StartButton_Click"
                Content="Start Gemini" />
            <Button
                x:Name="ReloadButton"
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Click="ReloadButton_Click"
                Content="Reload"
                IsEnabled="False" />
            <Button
                x:Name="RestartButton"
                Grid.Column="5"
                VerticalAlignment="Bottom"
                Click="RestartButton_Click"
                Content="Restart WebView"
                IsEnabled="False" />
            <Button
                x:Name="BrowserButton"
                Grid.Column="6"
                VerticalAlignment="Bottom"
                Click="BrowserButton_Click"
                Content="Open in browser" />
        </Grid>

        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid x:Name="WebViewHost">
                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Choose a provider and profile mode, then start a manual compatibility test."
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="EventLogBox"
                AcceptsReturn="True"
                FontFamily="Consolas"
                Header="Sanitized in-memory events"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Live diagnostics" />
                <TextBlock x:Name="ProviderStatusText" Text="Provider: not selected" TextWrapping="Wrap" />
                <TextBlock x:Name="PurchasePolicyText" Text="Purchase policy: not selected" TextWrapping="Wrap" />
                <TextBlock x:Name="ProfilePathText" Text="Profile: not started" TextWrapping="Wrap" />
                <TextBlock x:Name="ResourceText" Text="WebView processes: —&#x0a;Private memory: —&#x0a;CPU: —" />
                <Button Click="ClearLogButton_Click" Content="Clear event view" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
