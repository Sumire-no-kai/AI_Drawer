<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AIDrawer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIDrawer"
    xmlns:tb="using:H.NotifyIcon"
    Title="AI Drawer">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <XamlUICommand x:Key="OpenFromTrayCommand" ExecuteRequested="OpenFromTrayCommand_ExecuteRequested" />
            <XamlUICommand x:Key="SettingsFromTrayCommand" ExecuteRequested="SettingsFromTrayCommand_ExecuteRequested" />
            <XamlUICommand x:Key="ExitFromTrayCommand" ExecuteRequested="ExitFromTrayCommand_ExecuteRequested" />
            <MenuFlyout x:Key="TrayContextMenu">
                <MenuFlyoutItem
                    Text="Open AI Drawer"
                    Command="{StaticResource OpenFromTrayCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Text="Settings"
                    Command="{StaticResource SettingsFromTrayCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Text="Exit AI Drawer"
                    Command="{StaticResource ExitFromTrayCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="AI Drawer">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <local:MainPage x:Name="WorkspacePage" Grid.Row="1" />

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="AI Drawer"
            IconSource="/Assets/AppIcon.ico"
            LeftClickCommand="{StaticResource OpenFromTrayCommand}"
            ContextFlyout="{StaticResource TrayContextMenu}"
            MenuActivation="RightClick" />
    </Grid>
</Window>
