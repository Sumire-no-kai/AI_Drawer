<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AIDrawer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d"
    Loaded="MainPage_Loaded"
    Unloaded="MainPage_Unloaded">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewWorkspaceShortcut_Invoked" />
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="ProviderShortcut_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="PromptCancelShortcut_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceTabActiveBrush" Color="#105B77FF" />
                    <SolidColorBrush x:Key="HomeChooserSurfaceBrush" Color="#F7FFFFFF" />
                    <SolidColorBrush x:Key="ProviderChoiceBackgroundPointerOverBrush" Color="#205B77FF" />
                    <SolidColorBrush x:Key="ProviderChoiceBackgroundPressedBrush" Color="#365B77FF" />
                    <SolidColorBrush x:Key="ProviderChoiceBorderPointerOverBrush" Color="#605B77FF" />
                    <SolidColorBrush x:Key="ProviderChoiceBorderPressedBrush" Color="#805B77FF" />
                    <SolidColorBrush x:Key="PromptSurfaceBrush" Color="#FFFDFDFF" />
                    <SolidColorBrush x:Key="PromptScrimBrush" Color="#52111727" />
                    <SolidColorBrush x:Key="StatusInfoBrush" Color="#EDF3FF" />
                    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFF3D6" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FDEBEC" />
                    <Color x:Key="HomeGlowColor">#365B7CFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkspaceTabActiveBrush" Color="#245B77FF" />
                    <SolidColorBrush x:Key="HomeChooserSurfaceBrush" Color="#F21D1E22" />
                    <SolidColorBrush x:Key="ProviderChoiceBackgroundPointerOverBrush" Color="#34527FFF" />
                    <SolidColorBrush x:Key="ProviderChoiceBackgroundPressedBrush" Color="#4A527FFF" />
                    <SolidColorBrush x:Key="ProviderChoiceBorderPointerOverBrush" Color="#785B77FF" />
                    <SolidColorBrush x:Key="ProviderChoiceBorderPressedBrush" Color="#A05B77FF" />
                    <SolidColorBrush x:Key="PromptSurfaceBrush" Color="#FF202126" />
                    <SolidColorBrush x:Key="PromptScrimBrush" Color="#85000000" />
                    <SolidColorBrush x:Key="StatusInfoBrush" Color="#182B4A" />
                    <SolidColorBrush x:Key="StatusWarningBrush" Color="#3A2D13" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="#3C1F23" />
                    <Color x:Key="HomeGlowColor">#4A527FFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="WorkspaceTabActiveBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="HomeChooserSurfaceBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                    <StaticResource x:Key="ProviderChoiceBackgroundPointerOverBrush" ResourceKey="ControlFillColorSecondaryBrush" />
                    <StaticResource x:Key="ProviderChoiceBackgroundPressedBrush" ResourceKey="ControlFillColorTertiaryBrush" />
                    <StaticResource x:Key="ProviderChoiceBorderPointerOverBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ProviderChoiceBorderPressedBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
                    <StaticResource x:Key="PromptSurfaceBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                    <StaticResource x:Key="PromptScrimBrush" ResourceKey="SmokeFillColorDefaultBrush" />
                    <StaticResource x:Key="StatusInfoBrush" ResourceKey="SystemFillColorNeutralBackgroundBrush" />
                    <StaticResource x:Key="StatusWarningBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
                    <StaticResource x:Key="StatusErrorBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
                    <Color x:Key="HomeGlowColor">Transparent</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ThemeShadow x:Key="FloatingSurfaceShadow" />

            <Style x:Key="WorkspaceTabButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="124" />
                <Setter Property="MaxWidth" Value="200" />
                <Setter Property="Padding" Value="10,6,30,6" />
            </Style>

            <Style x:Key="WorkspaceActionButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceTabButtonStyle}">
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="8" />
            </Style>

            <Style x:Key="TabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="ProviderChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
            </Style>

            <Style x:Key="ActionMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinWidth" Value="250" />
                <Setter Property="Padding" Value="12,9" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Canvas.ZIndex="20"
            Padding="12,7"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalContentAlignment="Center">
                <StackPanel x:Name="WorkspaceTabs" Orientation="Horizontal" Spacing="6" />
            </ScrollViewer>

            <TextBlock
                x:Name="CompatibilityStatusText"
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button
                    Style="{StaticResource WorkspaceActionButtonStyle}"
                    AutomationProperties.Name="New workspace"
                    Click="NewWorkspaceButton_Click">
                    <FontIcon Glyph="&#xE710;" />
                </Button>
                <Button
                    x:Name="WorkspaceActionsButton"
                    Style="{StaticResource WorkspaceActionButtonStyle}"
                    AutomationProperties.Name="Workspace actions"
                    IsEnabled="False">
                    <FontIcon Glyph="&#xE712;" />
                    <Button.Flyout>
                        <Flyout x:Name="WorkspaceActionsFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border
                                Padding="6"
                                Background="{ThemeResource HomeChooserSurfaceBrush}"
                                CornerRadius="12"
                                Shadow="{StaticResource FloatingSurfaceShadow}"
                                Translation="0,0,18">
                                <StackPanel Spacing="2">
                                    <ToggleSwitch
                                        x:Name="KeepActiveToggle"
                                        Margin="12,8"
                                        AutomationProperties.Name="Keep active"
                                        Header="Keep active"
                                        OffContent="Normal disposal priority"
                                        OnContent="Last to dispose"
                                        Toggled="KeepActiveToggle_Toggled" />
                                    <Button Style="{StaticResource ActionMenuButtonStyle}" Click="ReloadButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                            <TextBlock x:Name="ReloadActionText" Text="Reload workspace" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionMenuButtonStyle}" Click="RestartButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE777;" FontSize="16" />
                                            <TextBlock x:Name="RestartActionText" Text="Restart workspace" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Style="{StaticResource ActionMenuButtonStyle}"
                                        AutomationProperties.Name="Reset website data"
                                        Click="ResetWebsiteDataMenuItem_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                            <TextBlock Text="Reset website data" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ExitApplicationButton"
                                        Style="{StaticResource ActionMenuButtonStyle}"
                                        AutomationProperties.Name="Exit AI Drawer"
                                        Click="ExitButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8BB;" FontSize="16" />
                                            <TextBlock Text="Exit AI Drawer" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="FeedbackSupportButton"
                    Style="{StaticResource WorkspaceActionButtonStyle}"
                    AutomationProperties.Name="Feedback and support"
                    Click="FeedbackSupportButton_Click">
                    <FontIcon Glyph="&#xE939;" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Style="{StaticResource WorkspaceActionButtonStyle}"
                    AutomationProperties.Name="Settings"
                    Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </StackPanel>

            <Border
                x:Name="NavigationActivityBar"
                Grid.ColumnSpan="3"
                Height="2"
                Margin="0,0,0,-7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="#596BFF"
                CornerRadius="1"
                Opacity="0"
                IsHitTestVisible="False" />
        </Grid>

        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Canvas.ZIndex="20"
            Margin="12,4,12,8"
            Padding="12,10"
            CornerRadius="11"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusAccent" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <FontIcon x:Name="StatusGlyph" Grid.Column="1" FontSize="16" Glyph="&#xE946;" />
                <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusMessage" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid x:Name="HomePanel">
                <Ellipse
                    Width="760"
                    Height="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Offset="0" Color="{ThemeResource HomeGlowColor}" />
                            <GradientStop Offset="1" Color="#005B7CFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <ScrollViewer
                    HorizontalContentAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        x:Name="HomeContentContainer"
                        MaxWidth="688"
                        HorizontalAlignment="Center">
                        <StackPanel
                            Margin="24,30"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="9">
                        <Image
                            Width="44"
                            Height="44"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            Source="Assets/AIDrawerMark.svg" />
                        <TextBlock
                            MaxWidth="600"
                            HorizontalAlignment="Center"
                            Text="Where do you want to work?"
                            FontSize="30"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            MaxWidth="470"
                            HorizontalAlignment="Center"
                            Text="Choose an AI platform to open a private workspace. Open the same platform again whenever you need another conversation."
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border
                            Margin="0,15,0,0"
                            Padding="7"
                            Background="{ThemeResource HomeChooserSurfaceBrush}"
                            CornerRadius="16"
                            Shadow="{StaticResource FloatingSurfaceShadow}"
                            Translation="0,0,20">
                            <StackPanel Spacing="3">
                                <Grid Margin="12,8,10,5">
                                    <TextBlock Text="Open a workspace" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Text="Ctrl+1–9"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid
                                    x:Name="ProviderChooser"
                                    AutomationProperties.Name="AI provider choices"
                                    ColumnSpacing="4"
                                    RowSpacing="3"
                                    SizeChanged="ProviderChooser_SizeChanged">
                                    <Grid.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ProviderChoiceBackgroundPointerOverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ProviderChoiceBackgroundPressedBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ProviderChoiceBorderPointerOverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ProviderChoiceBorderPressedBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Dark">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ProviderChoiceBackgroundPointerOverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ProviderChoiceBackgroundPressedBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ProviderChoiceBorderPointerOverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ProviderChoiceBorderPressedBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Grid.Resources>
                                </Grid>
                                <Button
                                    x:Name="MissingProviderFeedbackButton"
                                    Margin="8,2,8,5"
                                    Padding="4,3"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    AutomationProperties.Name="Can't find the AI you want? Tell me."
                                    AutomationProperties.HelpText="Opens the AI Drawer feedback form in your system browser."
                                    Click="MissingProviderFeedbackButton_Click">
                                    <TextBlock
                                        Text="Can't find the AI you want? Tell me."
                                        FontSize="12"
                                        TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="HomeSupportReminder"
                            MaxWidth="520"
                            Margin="0,8,0,0"
                            Padding="14"
                            Background="{ThemeResource HomeChooserSurfaceBrush}"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Support independent development" FontWeight="SemiBold" />
                                <TextBlock Text="This shared Buy Me a Coffee page supports Edward Lee's independent projects. Contributions do not activate or unlock AI Drawer, AI provider services, subscriptions, accounts, premium features, or support plans." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel
                                    x:Name="HomeSupportActions"
                                    HorizontalAlignment="Stretch"
                                    Orientation="Horizontal"
                                    SizeChanged="HomeSupportActions_SizeChanged"
                                    Spacing="8">
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AppPrimaryButtonStyle}" Content="Open Buy Me a Coffee" Click="SupportDevelopmentButton_Click" />
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AppSecondaryButtonStyle}" Content="Not now" Click="SupportNotNowButton_Click" />
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AppSecondaryButtonStyle}" Content="Don't ask again" Click="SupportNeverButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Text="Official websites · independent shell · conversations stay private"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="WebViewHost" Visibility="Collapsed" />

            <Grid
                x:Name="RecoveryPanel"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                TabFocusNavigation="Cycle"
                Visibility="Collapsed">
                <StackPanel
                    Width="420"
                    MaxWidth="{Binding ActualWidth, ElementName=RootLayout}"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <TextBlock x:Name="RecoveryTitle" Text="Workspace needs attention" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="RecoveryMessage"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AppPrimaryButtonStyle}" Content="Reload" Click="ReloadButton_Click" />
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" Content="Restart workspace" Click="RestartButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RecoveryKeepWaitingButton"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Content="Keep waiting"
                                Click="RecoveryKeepWaitingButton_Click"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="RecoveryOpenBrowserButton"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Content="Open in browser"
                                Click="RecoveryOpenBrowserButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="WorkspaceLoadingPanel"
                Canvas.ZIndex="30"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed">
                <Ellipse
                    Width="360"
                    Height="260"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Offset="0" Color="{ThemeResource HomeGlowColor}" />
                            <GradientStop Offset="1" Color="#005B7CFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="13">
                    <Image
                        x:Name="WorkspaceLoadingMark"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        Source="Assets/AIDrawerMark.svg" />
                    <TextBlock
                        x:Name="WorkspaceLoadingTitle"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Opening your workspace" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Your navigation stays available while the provider gets ready." />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            x:Name="SessionRecoveryOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="110"
            Background="{ThemeResource PromptScrimBrush}"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <Border
                Width="460"
                MaxWidth="{Binding ActualWidth, ElementName=RootLayout}"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PromptSurfaceBrush}"
                CornerRadius="16"
                Shadow="{StaticResource FloatingSurfaceShadow}"
                Translation="0,0,28">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="SessionRecoveryTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SessionRecoveryMessage"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="Retry leaves the existing file untouched. Backup creates a local recovery copy before AI Drawer can write a new session."
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SessionRecoveryExitButton"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            Content="Exit AI Drawer"
                            Click="SessionRecoveryExitButton_Click" />
                        <Button
                            x:Name="SessionRecoveryRetryButton"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            Content="Retry"
                            Click="SessionRecoveryRetryButton_Click" />
                        <Button
                            x:Name="SessionRecoveryBackupButton"
                            Style="{StaticResource AppPrimaryButtonStyle}"
                            Content="Back up and continue"
                            Click="SessionRecoveryBackupButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="PromptOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="100"
            Background="{ThemeResource PromptScrimBrush}"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <!-- Do not independently translate PromptCard. On high-DPI displays, this can
                 desynchronize its rendered and pointer-hit positions. -->
            <Border
                x:Name="PromptCard"
                Width="420"
                MaxWidth="{Binding ActualWidth, ElementName=RootLayout}"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PromptSurfaceBrush}"
                CornerRadius="16"
                Shadow="{StaticResource FloatingSurfaceShadow}">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="PromptTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PromptMessage"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <CheckBox x:Name="PromptRememberCheckBox" Content="Remember this decision in this provider profile on this device" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PromptSecondaryButton"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            IsHitTestVisible="True"
                            IsTabStop="True"
                            Click="PromptSecondaryButton_Click" />
                        <Button
                            x:Name="PromptPrimaryButton"
                            Style="{StaticResource AppPrimaryButtonStyle}"
                            IsHitTestVisible="True"
                            IsTabStop="True"
                            Click="PromptPrimaryButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="FeedbackSupportOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="95"
            Background="{ThemeResource PromptScrimBrush}"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <Border
                Width="620"
                MaxWidth="{Binding ActualWidth, ElementName=RootLayout}"
                MaxHeight="{Binding ActualHeight, ElementName=RootLayout}"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PromptSurfaceBrush}"
                CornerRadius="16"
                Shadow="{StaticResource FloatingSurfaceShadow}"
                Translation="0,0,24">
                <ScrollViewer>
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Feedback &amp; Support" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Help improve the independent AI Drawer project without sharing provider or account data."
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Name="FeedbackSupportCloseButton"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AppIconButtonStyle}"
                                AutomationProperties.Name="Close feedback and support"
                                Click="CloseFeedbackSupportButton_Click">
                                <FontIcon Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <Border
                            Padding="14"
                            Background="{ThemeResource StatusWarningBrush}"
                            CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Keep reports privacy-safe" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Never include prompts, responses, page content, full sensitive URLs, account identifiers, credentials, cookies, tokens, payment data, DOM captures, or network traces."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Feedback" FontSize="16" FontWeight="SemiBold" />
                            <Button
                                x:Name="ReportBugButton"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Send feedback or report a bug"
                                AutomationProperties.HelpText="Opens the AI Drawer Microsoft Forms feedback form in the system browser. Reports must not contain sensitive provider or account data."
                                Click="ReportBugButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEBE8;" FontSize="18" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Send feedback or report a bug" FontWeight="SemiBold" />
                                        <TextBlock Text="Microsoft Forms · missing provider, feature request, native shell, recovery, navigation, download, or packaging" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="ReportProviderEvidenceButton"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Report provider compatibility"
                                AutomationProperties.HelpText="Opens the bounded provider-compatibility evidence template in the system browser."
                                Click="ReportProviderEvidenceButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8F2;" FontSize="18" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Report provider compatibility" FontWeight="SemiBold" />
                                        <TextBlock Text="Public GitHub evidence · records environment and limits without account content" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold" />
                            <Button
                                x:Name="ReportSecurityButton"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Report a security issue privately"
                                AutomationProperties.HelpText="Opens GitHub Private Vulnerability Reporting in the system browser. The report is not a public issue."
                                Click="ReportSecurityButton_Click">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="18" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Report a security issue privately" FontWeight="SemiBold" />
                                        <TextBlock Text="Private GitHub security advisory · do not use a public issue for vulnerabilities" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Version &amp; build" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="FeedbackBuildInformationText"
                                AutomationProperties.Name="Version and build information"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            x:Name="SettingsOverlay"
            Grid.RowSpan="3"
            Canvas.ZIndex="90"
            Background="{ThemeResource PromptScrimBrush}"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed">
            <Border
                Width="660"
                MaxWidth="{Binding ActualWidth, ElementName=RootLayout}"
                MaxHeight="{Binding ActualHeight, ElementName=RootLayout}"
                Margin="24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PromptSurfaceBrush}"
                CornerRadius="16"
                Shadow="{StaticResource FloatingSurfaceShadow}"
                Translation="0,0,24">
                <ScrollViewer>
                    <StackPanel Spacing="18">
                        <Grid>
                            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                            <Button x:Name="SettingsCloseButton" HorizontalAlignment="Right" Style="{StaticResource AppIconButtonStyle}" AutomationProperties.Name="Close settings" Click="CloseSettingsButton_Click">
                                <FontIcon Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <StackPanel Spacing="8">
                            <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="DefaultProviderComboBox"
                                Header="Default provider"
                                AutomationProperties.Name="Default provider"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="DefaultProviderComboBox_SelectionChanged" />
                            <TextBlock Text="The default provider opens for a new workspace and from the notification-area menu. Choose Home to keep startup provider-free." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch
                                x:Name="GlobalShortcutEnabledToggle"
                                Header="Global shortcut"
                                AutomationProperties.Name="Global shortcut"
                                OnContent="Enabled"
                                OffContent="Disabled"
                                Toggled="GlobalShortcutSetting_Changed" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="ShortcutModifiersComboBox"
                                    Header="Modifiers"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="GlobalShortcutSetting_Changed">
                                    <ComboBoxItem Content="Win + Shift" Tag="Windows, Shift" />
                                    <ComboBoxItem Content="Win + Ctrl" Tag="Windows, Control" />
                                    <ComboBoxItem Content="Win + Alt" Tag="Windows, Alt" />
                                    <ComboBoxItem Content="Ctrl + Alt" Tag="Control, Alt" />
                                    <ComboBoxItem Content="Ctrl + Shift" Tag="Control, Shift" />
                                    <ComboBoxItem Content="Alt + Shift" Tag="Alt, Shift" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="ShortcutKeyComboBox"
                                    Grid.Column="1"
                                    Header="Key"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="GlobalShortcutSetting_Changed" />
                            </Grid>
                            <TextBlock x:Name="ShortcutStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch
                                x:Name="LaunchOnStartupToggle"
                                Header="Launch on startup"
                                AutomationProperties.Name="Launch on startup"
                                OnContent="Start hidden after sign-in"
                                OffContent="Do not start automatically"
                                Toggled="LaunchOnStartupToggle_Toggled" />
                            <TextBlock x:Name="LaunchOnStartupStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch
                                x:Name="CloseToTrayToggle"
                                Header="Close button behavior"
                                AutomationProperties.Name="Close button behavior"
                                OnContent="Hide in notification area"
                                OffContent="Exit AI Drawer"
                                Toggled="CloseToTrayToggle_Toggled" />
                            <ToggleSwitch
                                x:Name="AlwaysOnTopToggle"
                                Header="Always on top"
                                AutomationProperties.Name="Always on top"
                                OnContent="Keep above other windows"
                                OffContent="Normal window stacking"
                                Toggled="AlwaysOnTopToggle_Toggled" />
                            <TextBlock Text="Window size and position are saved locally after movement or resizing and are clamped to an available display on restore." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Workspaces &amp; local website data" FontSize="16" FontWeight="SemiBold" />
                            <ToggleSwitch
                                x:Name="RestoreExactWorkspaceToggle"
                                Header="Restore exact workspace after restart"
                                OnContent="Encrypted restricted locator enabled"
                                OffContent="Open provider home page"
                                Toggled="RestoreExactWorkspaceToggle_Toggled" />
                            <TextBlock Text="Only a reviewed provider origin and opaque conversation path may be saved. No page content, prompts, responses, cookies, credentials, query parameters, or fragments are stored." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="MemoryModeComboBox" Header="Memory mode (available after resource validation)" HorizontalAlignment="Stretch" IsEnabled="False" SelectionChanged="MemoryModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Low memory" Tag="LowMemory" />
                                <ComboBoxItem Content="Balanced" Tag="Balanced" />
                                <ComboBoxItem Content="Fast switching" Tag="FastSwitching" />
                            </ComboBox>
                            <TextBlock Text="Balanced is the current provisional policy. Low Memory and Fast Switching remain disabled until their Windows 10/11 pressure budgets are measured." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ProviderDataScopeText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ClearProviderCacheButton" Style="{StaticResource AppSecondaryButtonStyle}" Content="Clear provider cache" Click="ClearProviderCacheButton_Click" />
                                <Button x:Name="ResetProviderWebsiteDataButton" Style="{StaticResource AppSecondaryButtonStyle}" Content="Reset provider website data" Click="ResetProviderWebsiteDataButton_Click" />
                            </StackPanel>
                            <Button x:Name="ResetAllWebsiteDataButton" Style="{StaticResource AppSecondaryButtonStyle}" HorizontalAlignment="Left" Content="Reset all AI website data" Click="ResetAllWebsiteDataButton_Click" />
                            <TextBlock Text="Clear cache removes temporary web resources while preserving sign-in and site storage. Website-data reset signs affected provider workspaces out locally. Reset all affects every known AI Drawer provider profile and requires confirmation." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="About &amp; Privacy" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="AI Drawer is an independent open-source shell. It is not affiliated with or endorsed by the listed AI providers." TextWrapping="Wrap" />
                            <TextBlock Text="Providers own authentication, subscriptions, billing, cancellations, refunds, and conversations. AI Drawer does not read prompts, responses, page content, credentials, cookies, tokens, or payment information." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Only reviewed provider and authentication origins can be embedded. External links require confirmation before they open in your browser; known purchase routes are blocked inside AI Drawer." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource AppSecondaryButtonStyle}" HorizontalAlignment="Left" Content="Show privacy and product information" Click="ShowWelcomeButton_Click" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Support development" FontSize="16" FontWeight="SemiBold" />
                            <Button x:Name="SupportDevelopmentButton" Style="{StaticResource AppSecondaryButtonStyle}" HorizontalAlignment="Left" Content="Support Edward Lee's independent projects" Click="SupportDevelopmentButton_Click" />
                            <TextBlock x:Name="SupportLinkStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
